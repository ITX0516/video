# Built application files
*.apk
*.aar
*.ap_
*.aab

# Dalvik/ART
*.dex

# Java class files
*.class

# Generated
bin/
gen/
out/
release/

# Gradle
.gradle/
build/

# Local config (sdk path / machine-specific)
local.properties

# Proguard
proguard/

# Logs
*.log

# Android Studio
.navigation/
captures/
*.iml
.idea/

# Native builds
.externalNativeBuild
.cxx/

# Keystores (never commit signing keys)
*.jks
*.keystore

# OS cruft
.DS_Store
Thumbs.db

# The Gradle wrapper jar must ship in the repo (CI cannot run ./gradlew without it).
# It is force-tracked; keep this exception so a broad *.jar rule doesn't drop it.
!gradle/wrapper/gradle-wrapper.jar
